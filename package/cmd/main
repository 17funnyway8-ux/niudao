#!/bin/bash
# 牛刀 · 运行控制：start / stop / status
# 说明：服务通过 Unix Socket 挂到飞牛统一网关（/app/niudao），不占用主机端口。
set -u

export PATH=/var/apps/nodejs_v22/target/bin:/var/apps/python312/target/bin:$PATH

APP_DIR="${TRIM_APPDEST:-/var/apps/niudao/target}/runtime"
DATA_DIR="${TRIM_PKGVAR:-/var/apps/niudao/var}"
SOCKET_PATH="${TRIM_APPDEST:-/var/apps/niudao/target}/app.sock"
LOG_FILE="${DATA_DIR}/app.log"
PID_FILE="${DATA_DIR}/app.pid"

mkdir -p "$DATA_DIR"

log() { echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "$LOG_FILE"; }

alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

pid_of() {
  [ -f "$PID_FILE" ] || return 1
  local p
  p="$(head -n 1 "$PID_FILE" | tr -d '[:space:]')"
  if alive "$p"; then
    echo "$p"
    return 0
  fi
  rm -f "$PID_FILE"
  return 1
}

start_app() {
  if pid_of > /dev/null; then
    return 0
  fi
  if [ ! -f "$APP_DIR/server/index.js" ]; then
    echo "应用文件缺失：$APP_DIR/server/index.js，请重新安装。" > "$TRIM_TEMP_LOGFILE"
    log "missing $APP_DIR/server/index.js"
    return 1
  fi
  if ! command -v node > /dev/null 2>&1; then
    echo "缺少 Node.js 运行时（nodejs_v22），请重新安装应用。" > "$TRIM_TEMP_LOGFILE"
    log "node not found"
    return 1
  fi

  log "starting $TRIM_APPNAME $TRIM_APPVER"
  rm -f "$SOCKET_PATH"
  cd "$APP_DIR" || return 1
  NIUDAO_DATA="$DATA_DIR" NIUDAO_TARGET="$DATA_DIR" \
    node "$APP_DIR/server/index.js" --socket "$SOCKET_PATH" >> "$LOG_FILE" 2>&1 &
  echo "$!" > "$PID_FILE"
  sleep 1
  if pid_of > /dev/null; then
    log "started pid $(cat "$PID_FILE")"
    return 0
  fi
  echo "牛刀启动失败，详情见 $LOG_FILE" > "$TRIM_TEMP_LOGFILE"
  log "start failed, see log"
  return 1
}

stop_app() {
  local p
  p="$(pid_of)" || {
    rm -f "$SOCKET_PATH"
    return 0
  }
  log "stopping pid $p"
  kill -TERM "$p" 2>/dev/null || true
  local i=0
  while alive "$p" && [ "$i" -lt 10 ]; do
    sleep 1
    i=$((i + 1))
  done
  if alive "$p"; then
    kill -KILL "$p" 2>/dev/null || true
  fi
  rm -f "$PID_FILE" "$SOCKET_PATH"
  log "stopped"
}

case "${1:-}" in
  start)
    start_app || exit 1
    ;;
  stop)
    stop_app
    ;;
  status)
    if pid_of > /dev/null; then
      exit 0
    fi
    exit 3
    ;;
  *)
    echo "Unknown command: ${1:-}" > "$TRIM_TEMP_LOGFILE"
    exit 1
    ;;
esac
