#!/bin/bash
# 安装后：准备数据目录，并把安装向导里填的偏好写进 settings.json。
set -u

DATA_DIR="${TRIM_PKGVAR:-/var/apps/niudao/var}"
mkdir -p "$DATA_DIR"
echo "牛刀数据目录: $DATA_DIR"

NODE_BIN="/var/apps/nodejs_v22/target/bin/node"
if [ -x "$NODE_BIN" ] && [ -f "${TRIM_APPDEST}/runtime/server/init-settings.js" ]; then
  # 用环境变量传参，避免把用户输入拼进 shell
  W_DISK="${wizard_disk_mb:-}" W_AUTO="${wizard_auto_submit:-}" \
    "$NODE_BIN" "${TRIM_APPDEST}/runtime/server/init-settings.js" "${DATA_DIR}/settings.json" \
    >> "${DATA_DIR}/install.log" 2>&1 || echo "初始化设置失败（不影响使用，可在应用内修改）"
else
  echo "Node.js 运行时未就绪，跳过设置初始化（可在应用内设置）"
fi

exit 0
